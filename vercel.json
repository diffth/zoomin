{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/index.html", "destination": "/ko", "permanent": true },
    { "source": "/uploadphotos.html", "destination": "/ko/upload", "permanent": true },
    { "source": "/myphotos.html", "destination": "/ko/my-photos", "permanent": true },
    { "source": "/downloadphotos.html", "destination": "/ko/download", "permanent": true },
    { "source": "/upload", "destination": "/ko/upload", "permanent": true },
    { "source": "/my-photos", "destination": "/ko/my-photos", "permanent": true },
    { "source": "/download", "destination": "/ko/download", "permanent": true },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "^en.*" }],
      "destination": "/en",
      "permanent": false
    },
    { "source": "/", "destination": "/ko", "permanent": false }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
