# Netlify-style host config.
# Real 301s for the URLs the old static site published, pointing at the default
# (Korean) locale. Client-side <Navigate> in App.tsx covers hosts without this file.
/index.html            /ko            301
/uploadphotos.html     /ko/upload     301
/myphotos.html         /ko/my-photos  301
/downloadphotos.html   /ko/download   301

# Unprefixed paths → default locale.
/upload                /ko/upload     301
/my-photos             /ko/my-photos  301
/download              /ko/download   301

# Language negotiation for the bare root: redirect to default locale (ko).
# Client router inside App.tsx will honor browser locale or saved preference.
/                      /ko            302

# SPA fallback — every other path is handled by the client router.
/*                     /index.html    200
